{
  "name": "the-party",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @party/server --filter @party/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "tsc --noEmit -p tsconfig.e2e.json && pnpm --recursive typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "pnpm --dir apps/web exec vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test:coverage && pnpm test:ui && pnpm build",
    "check:all": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.0.0",
    "fastify": "^5.12.8",
    "jsdom": "^27.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  }
}
